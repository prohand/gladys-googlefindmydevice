{
  "manifest_version": 1,
  "type": "device",
  "name": "Google Find My Device",
  "description": {
    "en": "Locate and ring your Android phones and Find Hub trackers from Gladys.",
    "fr": "Localisez et faites sonner vos téléphones Android et traceurs Find Hub depuis Gladys.",
    "de": "Orte deine Android-Handys und Find-Hub-Tracker und lass sie aus Gladys klingeln.",
    "es": "Localice y haga sonar sus móviles Android y rastreadores Find Hub desde Gladys."
  },
  "version": "0.0.0",
  "docker_image": "ghcr.io/prohand/gladys-googlefindmydevice:0.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-googlefindmydevice/main/cover.png",
  "categories": ["security", "services"],
  "keywords": [
    "find my device",
    "find hub",
    "localiser mon appareil",
    "android",
    "pixel",
    "gps tracker",
    "bluetooth tracker",
    "chipolo",
    "pebblebee",
    "presence"
  ],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Google offers no public API for Find My Device. On a computer with Chrome, run GoogleFindMyTools once (python main.py), sign in, then locate one of your devices: it asks for the screen lock PIN of one of your Android devices to unlock the encrypted locations. It then writes Auth/secrets.json: paste its whole content below.",
        "fr": "Google ne propose pas d'API publique pour Localiser mon appareil. Sur un ordinateur avec Chrome, lancez une fois GoogleFindMyTools (python main.py), connectez-vous, puis localisez un de vos appareils : il demande le code de verrouillage d'un de vos appareils Android pour ouvrir les positions chiffrées. Il écrit alors Auth/secrets.json : collez tout son contenu ci-dessous.",
        "de": "Google bietet keine öffentliche API für „Mein Gerät finden“. Starte auf einem Computer mit Chrome einmal GoogleFindMyTools (python main.py), melde dich an und orte eines deiner Geräte: Es fragt nach der PIN der Displaysperre eines deiner Android-Geräte, um die verschlüsselten Positionen zu öffnen. Danach schreibt es Auth/secrets.json: Füge den gesamten Inhalt unten ein.",
        "es": "Google no ofrece una API pública para Encontrar mi dispositivo. En un ordenador con Chrome, ejecute una vez GoogleFindMyTools (python main.py), inicie sesión y localice uno de sus dispositivos: le pedirá el PIN de bloqueo de uno de sus dispositivos Android para abrir las posiciones cifradas. Después escribe Auth/secrets.json: pegue todo su contenido abajo."
      },
      "links": [
        {
          "url": "https://github.com/leonboe1/GoogleFindMyTools",
          "label": {
            "en": "GoogleFindMyTools",
            "fr": "GoogleFindMyTools",
            "de": "GoogleFindMyTools",
            "es": "GoogleFindMyTools"
          }
        },
        {
          "url": "https://github.com/prohand/gladys-googlefindmydevice/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "secrets_json",
      "type": "secret",
      "label": {
        "en": "Content of secrets.json",
        "fr": "Contenu de secrets.json",
        "de": "Inhalt von secrets.json",
        "es": "Contenido de secrets.json"
      },
      "description": {
        "en": "The whole file, from { to }. It gives full access to your Google account's devices: keep it private.",
        "fr": "Tout le fichier, de { à }. Il donne accès aux appareils de votre compte Google : gardez-le privé.",
        "de": "Die ganze Datei, von { bis }. Sie gibt Zugriff auf die Geräte deines Google-Kontos: Halte sie geheim.",
        "es": "Todo el archivo, de { a }. Da acceso a los dispositivos de su cuenta de Google: manténgalo en privado."
      },
      "required": true,
      "placeholder": {
        "en": "{\"username\": \"…\", \"aas_token\": \"…\", …}",
        "fr": "{\"username\": \"…\", \"aas_token\": \"…\", …}",
        "de": "{\"username\": \"…\", \"aas_token\": \"…\", …}",
        "es": "{\"username\": \"…\", \"aas_token\": \"…\", …}"
      }
    },
    {
      "key": "house",
      "type": "select",
      "source": "houses",
      "label": {
        "en": "Home",
        "fr": "Maison",
        "de": "Zuhause",
        "es": "Casa"
      },
      "description": {
        "en": "The Gladys house used for presence and distance. Empty: the first house with a location.",
        "fr": "La maison Gladys utilisée pour la présence et la distance. Vide : la première maison localisée.",
        "de": "Das Gladys-Haus für Anwesenheit und Entfernung. Leer: das erste Haus mit Standort.",
        "es": "La casa de Gladys usada para la presencia y la distancia. Vacío: la primera casa con ubicación."
      },
      "required": false
    },
    {
      "key": "home_radius",
      "type": "number",
      "label": {
        "en": "Home radius (m)",
        "fr": "Rayon de la maison (m)",
        "de": "Radius um das Zuhause (m)",
        "es": "Radio de la casa (m)"
      },
      "description": {
        "en": "A device closer than this to the house is at home.",
        "fr": "Un appareil plus proche que cela de la maison est à la maison.",
        "de": "Ein Gerät, das näher am Haus ist, gilt als zu Hause.",
        "es": "Un dispositivo más cerca que esto de la casa está en casa."
      },
      "required": false,
      "default": 150,
      "min": 50,
      "max": 5000
    },
    {
      "key": "refresh_interval",
      "type": "number",
      "label": {
        "en": "Locate every (minutes)",
        "fr": "Localiser toutes les (minutes)",
        "de": "Orten alle (Minuten)",
        "es": "Localizar cada (minutos)"
      },
      "description": {
        "en": "Automatic locate requests, 5 minutes minimum. 0: only on demand. Each request wakes the devices: keep it reasonable for their battery.",
        "fr": "Demandes de localisation automatiques, 5 minutes minimum. 0 : uniquement à la demande. Chaque demande réveille les appareils : restez raisonnable pour leur batterie.",
        "de": "Automatische Ortungsanfragen, mindestens 5 Minuten. 0: nur auf Abruf. Jede Anfrage weckt die Geräte: Bleib mit Rücksicht auf ihren Akku vernünftig.",
        "es": "Solicitudes automáticas de localización, 5 minutos como mínimo. 0: solo a petición. Cada solicitud despierta los dispositivos: sea razonable por su batería."
      },
      "required": false,
      "default": 15,
      "min": 0,
      "max": 1440
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
    },
    {
      "key": "locate",
      "label": {
        "en": "Locate a device",
        "fr": "Localiser un appareil",
        "de": "Ein Gerät orten",
        "es": "Localizar un dispositivo"
      },
      "timeout_seconds": 75,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Dispositivo"
          },
          "required": true
        }
      ]
    },
    {
      "key": "ring",
      "label": {
        "en": "Ring a device",
        "fr": "Faire sonner un appareil",
        "de": "Ein Gerät klingeln lassen",
        "es": "Hacer sonar un dispositivo"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil",
            "de": "Gerät",
            "es": "Dispositivo"
          },
          "required": true
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "find_my_devices",
      "label": {
        "en": "Find My Device",
        "fr": "Localiser",
        "de": "Gerät finden",
        "es": "Encontrar"
      },
      "description": {
        "en": "Where your devices are, with Locate and Ring buttons.",
        "fr": "Où sont vos appareils, avec les boutons Localiser et Sonner.",
        "de": "Wo deine Geräte sind, mit den Tasten Orten und Klingeln.",
        "es": "Dónde están sus dispositivos, con botones Localizar y Sonar."
      },
      "icon": "map-pin",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Only this device",
            "fr": "Uniquement cet appareil",
            "de": "Nur dieses Gerät",
            "es": "Solo este dispositivo"
          },
          "description": {
            "en": "Empty: every device in a list.",
            "fr": "Vide : tous les appareils dans une liste.",
            "de": "Leer: alle Geräte in einer Liste.",
            "es": "Vacío: todos los dispositivos en una lista."
          },
          "required": false
        }
      ],
      "action_timeout_seconds": 90
    }
  ],
